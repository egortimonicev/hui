# Порт веб-сервера
PORT=3000

# Токен бота от @BotFather. Пока он пустой, работает демо-вход с выбором пользователя.
BOT_TOKEN=
# Имя бота без @ — нужно для ссылок-приглашений вида t.me/<бот>?startapp=inv_...
BOT_USERNAME=
# Ваш числовой Telegram ID: при первом запуске с ним будет создан начальник.
ADMIN_TG_ID=

# Разрешить демо-вход в production без BOT_TOKEN (только для показа, не для реальной работы)
DEMO_MODE=

# Часовой пояс стройки: по нему считается «сегодня» в табеле и отчётах
APP_TZ=Europe/Moscow

# Где лежат база и фото отчётов (по умолчанию — папка data рядом с проектом)
DB_PATH=data/brigada.db
UPLOADS_DIR=data/uploads
